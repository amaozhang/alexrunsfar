---
import { downsample, feet, type Track } from '../lib/gpx';

interface Props { track: Track; label?: string }
const { track, label = 'Elevation' } = Astro.props;

// One series, so no legend — the heading names it. Distance on x, feet on y.
const N = 700;
const idx = downsample(track.points.map((_, i) => i), N);
const pts = idx
  .map((i) => ({ x: track.dist[i], y: track.points[i].ele }))
  .filter((p) => typeof p.y === 'number') as { x: number; y: number }[];

const W = 1000, H = 260, PAD = { t: 18, r: 8, b: 26, l: 44 };
const xs = pts.map((p) => p.x), ys = pts.map((p) => feet(p.y));
const x0 = 0, x1 = Math.max(...xs);
const yMin = Math.min(...ys), yMax = Math.max(...ys);
// Round the y-domain out to clean 500ft steps so gridlines land on real numbers.
const step = (yMax - yMin) > 4000 ? 1000 : 500;
const lo = Math.floor(yMin / step) * step;
const hi = Math.ceil(yMax / step) * step;

const sx = (v: number) => PAD.l + ((v - x0) / (x1 - x0)) * (W - PAD.l - PAD.r);
const sy = (v: number) => PAD.t + (1 - (v - lo) / (hi - lo)) * (H - PAD.t - PAD.b);

const line = pts.map((p, i) => `${i ? 'L' : 'M'}${sx(p.x).toFixed(1)},${sy(feet(p.y)).toFixed(1)}`).join('');
const area = `${line}L${sx(x1).toFixed(1)},${sy(lo).toFixed(1)}L${sx(x0).toFixed(1)},${sy(lo).toFixed(1)}Z`;

const yTicks: number[] = [];
for (let v = lo; v <= hi; v += step) yTicks.push(v);
const xTicks = Array.from({ length: 5 }, (_, i) => Math.round((x1 / 4) * i));

// Direct-label the high point rather than numbering every sample.
const peak = pts.reduce((a, b) => (b.y > a.y ? b : a), pts[0]);
const uid = 'ep' + Math.random().toString(36).slice(2, 8);
---
<figure class="chart" data-chart={uid}>
  <figcaption class="chart__head">
    <span class="chart__title">{label}</span>
    <span class="chart__readout" data-readout>
      {track.gainFt?.toLocaleString()} ft gain · high point {feet(peak.y).toLocaleString()} ft
    </span>
  </figcaption>

  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label={`Elevation profile: ${x1.toFixed(1)} miles, ${track.gainFt?.toLocaleString()} feet of gain, high point ${feet(peak.y).toLocaleString()} feet.`}>
    <g class="chart__grid">
      {yTicks.map((v) => <line x1={PAD.l} x2={W - PAD.r} y1={sy(v)} y2={sy(v)} />)}
    </g>
    <g class="chart__ylab">
      {yTicks.map((v) => <text x={PAD.l - 8} y={sy(v) + 3.5} text-anchor="end">{(v / 1000).toFixed(v % 1000 ? 1 : 0)}k</text>)}
    </g>
    <g class="chart__xlab">
      {xTicks.map((v) => <text x={sx(v)} y={H - 8} text-anchor={v === 0 ? 'start' : v === xTicks.at(-1) ? 'end' : 'middle'}>{v} mi</text>)}
    </g>

    <path class="chart__area" d={area} />
    <path class="chart__line" d={line} />

    <circle class="chart__peak" cx={sx(peak.x)} cy={sy(feet(peak.y))} r="4" />

    <g class="chart__hover" data-hover hidden>
      <line data-cross y1={PAD.t} y2={H - PAD.b} />
      <circle data-dot r="4.5" />
    </g>
    <rect class="chart__hit" data-hit x={PAD.l} y={PAD.t} width={W - PAD.l - PAD.r} height={H - PAD.t - PAD.b} />
  </svg>

  <script is:inline define:vars={{ uid, pts, PAD, W, H, x0, x1, lo, hi }}>
    (function () {
      const root = document.querySelector(`[data-chart="${uid}"]`);
      if (!root) return;
      const svg = root.querySelector('svg');
      const hover = root.querySelector('[data-hover]');
      const cross = root.querySelector('[data-cross]');
      const dot = root.querySelector('[data-dot]');
      const out = root.querySelector('[data-readout]');
      const base = out.textContent;
      const FT = 3.280839895;
      const sx = (v) => PAD.l + ((v - x0) / (x1 - x0)) * (W - PAD.l - PAD.r);
      const sy = (v) => PAD.t + (1 - (v - lo) / (hi - lo)) * (H - PAD.t - PAD.b);

      function move(e) {
        const r = svg.getBoundingClientRect();
        const mi = x0 + ((e.clientX - r.left) / r.width * W - PAD.l) / (W - PAD.l - PAD.r) * (x1 - x0);
        let best = pts[0];
        for (const p of pts) if (Math.abs(p.x - mi) < Math.abs(best.x - mi)) best = p;
        const px = sx(best.x), py = sy(Math.round(best.y * FT));
        cross.setAttribute('x1', px); cross.setAttribute('x2', px);
        dot.setAttribute('cx', px); dot.setAttribute('cy', py);
        hover.hidden = false;
        out.textContent = `${best.x.toFixed(1)} mi · ${Math.round(best.y * FT).toLocaleString()} ft`;
      }
      function leave() { hover.hidden = true; out.textContent = base; }
      svg.addEventListener('pointermove', move);
      svg.addEventListener('pointerleave', leave);
    })();
  </script>
</figure>
