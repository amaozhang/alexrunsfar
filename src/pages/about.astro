---
import Base from '../layouts/Base.astro';
import Stats from '../components/Stats.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/site/portrait.png';
import { allRaces, careerStats, spell } from '../lib/races';
import { site, bioWith } from '../lib/site';

const races = await allRaces();
const stats = careerStats(races);
---
<Base title="About">
  <div class="wrap page-head">
    <p class="eyebrow">Who</p>
    <h1 class="page-title">About</h1>
  </div>

  <div class="wrap section">
    <div class="feature">
      <div class="feature__media"><Image src={portrait} alt="Alex Zhang" widths={[400, 800]} sizes="(min-width:52rem) 45vw, 100vw" /></div>
      <div class="prose">
        <p>{bioWith(spell(stats.count))}</p>
        <p>
          He runs out of Seattle now, mostly on the trails east of the city. Before that it was
          Brooklyn and Prospect Park.
        </p>
        <p style="margin-block-start:1.75rem">
          <a class="follow__btn" href={site.links.strava} rel="noopener">Follow on Strava &rarr;</a>
        </p>
        <p class="card__meta">
          Race results on <a href={site.links.ultrasignup} rel="noopener">UltraSignup</a>.
          Work things on <a href={site.links.linkedin} rel="noopener">LinkedIn</a>.
        </p>
      </div>
    </div>
  </div>

  <div class="wrap section"><Stats races={races} /></div>
</Base>
